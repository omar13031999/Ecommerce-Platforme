# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------
# Public base URL (used for OAuth redirect URIs and webhook URLs)
APP_URL=http://localhost:3000
# Shared secret for the scheduler calling /api/cron (min. 24 chars)
#   openssl rand -hex 32
CRON_SECRET=
# 32 random bytes, base64 — encrypts integration tokens & API keys at rest
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- Google Sheets (optional) — Google Cloud Console > APIs & Services -------
# Redirect URI to register: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta Marketing API (optional) — developers.facebook.com --------------------
# Redirect URI to register: ${APP_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
